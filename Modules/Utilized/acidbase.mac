/* Acid-base database: flat list [acid, pKa, pKb, base, nH, acid, pKa, pKb, base, nH, ...] 
   nH = number of acidic protons for that species */
%_ACIDBASE_DATA: [
    /* Strong acids (pKa < 0) */
    "H3O+", 0, 14, "H2O", 1,
    "HCl", -7.0, 21.0, "Cl-", 1,
    "HBr", -9.0, 23.0, "Br-", 1,
    "HI", -10.0, 24.0, "I-", 1,
    "H2SO4", -2.0, 16.0, "HSO4-", 2,
    "HNO3", -1.0, 15.0, "NO3-", 1,
    "HClO4", -10.0, 24.0, "ClO4-", 1,
    "HClO3", -1.0, 15.0, "ClO3-", 1,
    
    /* Weak acids (pKa > 0) */
    "H2O", 14, 0, "OH-", 1,
    "HSO4-", 1.92, 12.08, "SO4^{2-}", 1,
    "H3PO4", 2.12, 11.88, "H2PO4-", 3,
    "H2PO4-", 7.21, 6.79, "HPO4^{2-}", 2,
    "HPO4^{2-}", 12.32, 1.68, "PO4^{3-}", 1,
    "HF", 3.17, 10.83, "F-", 1,
    "HNO2", 3.25, 10.75, "NO2-", 1,
    "HCOOH", 3.75, 10.25, "HCOO-", 1,
    "C6H5COOH", 4.20, 9.80, "C6H5COO-", 1,
    "CH3COOH", 4.76, 9.24, "CH3COO-", 1,
    "H2CO3", 6.35, 7.65, "HCO3-", 2,
    "HCO3-", 10.33, 3.67, "CO3^{2-}", 1,
    "H2S", 7.00, 7.00, "HS-", 2,
    "HS-", 12.89, 1.11, "S^{2-}", 1,
    "HClO2", 1.94, 12.06, "ClO2-", 1,
    "HClO", 7.53, 6.47, "ClO-", 1,
    "HBrO", 8.59, 5.41, "BrO-", 1,
    "HIO", 10.64, 3.36, "IO-", 1,
    "HCN", 9.21, 4.79, "CN-", 1,
    "NH4+", 9.25, 4.75, "NH3", 1,
    "H2O2", 11.62, 2.38, "HO2-", 2,
    "C6H5OH", 9.95, 4.05, "C6H5O-", 1,
    "H3BO3", 9.24, 4.76, "H2BO3-", 3,
    "H2SiO3", 9.77, 4.23, "HSiO3-", 2,
    "HSiO3-", 11.80, 2.20, "SiO3^{2-}", 1,
    "H2C2O4", 1.25, 12.75, "HC2O4-", 2,
    "HC2O4-", 4.27, 9.73, "C2O4^{2-}", 1,
    "H2SO3", 1.81, 12.19, "HSO3-", 2,
    "HSO3-", 6.91, 7.09, "SO3^{2-}", 1,
    "H3AsO4", 2.22, 11.78, "H2AsO4-", 3,
    "H2AsO4-", 6.98, 7.02, "HAsO4^{2-}", 2,
    "HAsO4^{2-}", 11.50, 2.50, "AsO4^{3-}", 1,
    "H2CrO4", 0.74, 13.26, "HCrO4-", 2,
    "HCrO4-", 6.49, 7.51, "CrO4^{2-}", 1,
    "CH3NH3+", 10.64, 3.36, "CH3NH2", 1,
    "(CH3)2NH2+", 10.73, 3.27, "(CH3)2NH", 1,
    "(CH3)3NH+", 9.80, 4.20, "(CH3)3N", 1,
    "C2H5NH3+", 10.81, 3.19, "C2H5NH2", 1,
    "C6H5NH3+", 4.63, 9.37, "C6H5NH2", 1,
    "N2H5+", 8.07, 5.93, "N2H4", 1,
    "HONH3+", 5.96, 8.04, "HONH2", 1,
    "H2NCONH3+", 0.18, 13.82, "H2NCONH2", 1,
    "C5H5NH+", 5.23, 8.77, "C5H5N", 1
]$

/* Helper: find index of acid (returns position of acid, or 0 if not found) */
_acidbase_find_acid(acid) := block([i, n, result],
    n: length(%_ACIDBASE_DATA),
    result: 0,
    for i: 1 step 5 thru n do (
        if is(%_ACIDBASE_DATA[i] = acid) then (result: i, return(result))
    ),
    result
)$

/* Helper: find index of base (returns starting position of entry, or 0 if not found) */
_acidbase_find_base(base) := block([i, n, result],
    n: length(%_ACIDBASE_DATA),
    result: 0,
    for i: 4 step 5 thru n do (
        if is(%_ACIDBASE_DATA[i] = base) then (result: i - 3, return(result))
    ),
    result
)$

/* Get pKa for an ACID - acid is at idx, pKa is at idx+1 */
chem_acidbase_pKa(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 1]
)$

/* Get pKb for a BASE - find entry via base, pKb is at idx+2 */
chem_acidbase_pKb(base) := block([idx],
    idx: _acidbase_find_base(base),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 2]
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if is(pKa = null) then null
    else if not numberp(pKa) then null
    else 10^(-pKa)
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if is(pKb = null) then null
    else if not numberp(pKb) then null
    else 10^(-pKb)
)$

/* Get number of acidic protons for an acid */
chem_acidbase_nH(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 4]
)$

/* Get conjugate base for an acid - acid at idx, base at idx+3 */
chem_acidbase_conjugate_base(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then "" else %_ACIDBASE_DATA[idx + 3]
)$

/* Get conjugate acid for a base - entry starts at idx, acid at idx */
chem_acidbase_conjugate_acid(base) := block([idx],
    idx: _acidbase_find_base(base),
    if is(idx = 0) then "" else %_ACIDBASE_DATA[idx]
)$

/* Navigation arrays */

/* All acids */
chem_acid_array() := block([result, i, n],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do result: append(result, [%_ACIDBASE_DATA[i]]),
    result
)$

/* All bases */
chem_base_array() := block([result, i, n],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 4 step 5 thru n do result: append(result, [%_ACIDBASE_DATA[i]]),
    result
)$

/* Strong acids: pKa < 0 */
chem_strong_acid_array() := block([result, i, n, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        if numberp(pKa) and is(pKa < 0) then result: append(result, [%_ACIDBASE_DATA[i]])
    ),
    result
)$

/* Weak acids: pKa > 0 */
chem_weak_acid_array() := block([result, i, n, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        if numberp(pKa) and is(pKa > 0) then result: append(result, [%_ACIDBASE_DATA[i]])
    ),
    result
)$

/* Strong bases: pKb <= 0 */
chem_strong_base_array() := block([result, i, n, pKb],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKb: %_ACIDBASE_DATA[i + 2],
        if numberp(pKb) and is(pKb <= 0) then result: append(result, [%_ACIDBASE_DATA[i + 3]])
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 */
chem_weak_base_array() := block([result, i, n, pKb],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKb: %_ACIDBASE_DATA[i + 2],
        if numberp(pKb) and is(pKb > 0) and is(pKb < 14) then result: append(result, [%_ACIDBASE_DATA[i + 3]])
    ),
    result
)$

/* Acids with specific number of acidic protons */
chem_acid_array_nH(nH_target) := block([result, i, n, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(nH) and is(nH = nH_target) then result: append(result, [%_ACIDBASE_DATA[i]])
    ),
    result
)$

/* Strong acids with specific number of acidic protons */
chem_strong_acid_array_nH(nH_target) := block([result, i, n, pKa, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(pKa) and is(pKa < 0) and numberp(nH) and is(nH = nH_target) then 
            result: append(result, [%_ACIDBASE_DATA[i]])
    ),
    result
)$

/* Weak acids with specific number of acidic protons */
chem_weak_acid_array_nH(nH_target) := block([result, i, n, pKa, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 step 5 thru n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(pKa) and is(pKa > 0) and numberp(nH) and is(nH = nH_target) then 
            result: append(result, [%_ACIDBASE_DATA[i]])
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$

/****************************************************************/
/*                                                              */
/*  Titration Analysis Functions                                */
/*                                                              */
/****************************************************************/

/* Constants */
%_Kw: 1.0e-14$  /* Ion product of water at 25°C */

/* Calculate pH from H+ concentration */
chem_titration_pH(H_concentration) := block([],
    if H_concentration <= 0 then return(14)
    else return(-log(H_concentration) / log(10))
)$

/* Calculate H+ concentration from pH */
chem_titration_H_from_pH(pH) := block([],
    return(10^(-pH))
)$

/* Generate titration curve data points
   acid_formula: string like "CH3COOH"
   acid_concentration: molarity of acid (mol/L)
   acid_volume: volume of acid in mL
   titrant_concentration: molarity of NaOH (mol/L)
   Returns: list of [volume_added, pH] pairs */
chem_titration_curve_points(acid_formula, acid_concentration, acid_volume, titrant_concentration) := block([
    pKa, Ka, nH, V_eq, points, V_added, n_acid, n_titrant, 
    pH, H_conc, alpha, i, V_max, step_size, n_steps],
    
    /* Get acid properties */
    pKa: chem_acidbase_pKa(acid_formula),
    nH: chem_acidbase_nH(acid_formula),
    
    if is(pKa = null) or is(nH = null) then (
        print("Error: Acid not found in database or missing pKa/nH"),
        return(false)
    ),
    
    Ka: 10^(-pKa),
    n_acid: acid_concentration * acid_volume,  /* mmol of acid */
    V_eq: n_acid / titrant_concentration,      /* Equivalence volume in mL */
    
    points: [],
    V_max: V_eq * 1.5,  /* Plot up to 150% of equivalence volume */
    step_size: V_max / 100,  /* 100 data points */
    
    for i: 0 thru 100 do (
        V_added: i * step_size,
        n_titrant: titrant_concentration * V_added,
        
        if V_added = 0 then (
            /* Initial pH: weak acid */
            H_conc: sqrt(Ka * acid_concentration),
            pH: chem_titration_pH(H_conc)
        ) else if V_added < V_eq then (
            /* Before equivalence point: Henderson-Hasselbalch */
            pH: pKa + log((V_eq - V_added) / V_added) / log(10)
        ) else if is(V_added = V_eq) then (
            /* At equivalence point: conjugate base pH */
            /* For weak acid, conjugate base Kb = Kw/Ka */
            pH: 7 + 0.5 * (pKa + log(acid_volume / (acid_volume + V_eq)) / log(10))
        ) else (
            /* After equivalence point: excess NaOH */
            n_excess_OH: n_titrant - n_acid,
            V_total: acid_volume + V_added,
            OH_conc: n_excess_OH / V_total,
            pOH: -log(OH_conc) / log(10),
            pH: 14 - pOH
        ),
        
        points: append(points, [[V_added, pH]])
    ),
    
    return(points)
)$

/* Main function: Generate HTML/JavaScript for titration plot
   Usage: chem_titration_plot("CH3COOH", 0.1, 50, 0.1) */
chem_titration_plot(acid_formula, acid_conc, acid_vol_mL, titrant_conc) := block([
    points, pKa, V_eq, n_acid, plot_html, json_points, i],
    
    /* Validate inputs */
    if not stringp(acid_formula) then return("Error: acid_formula must be a string"),
    if not numberp(acid_conc) or acid_conc <= 0 then return("Error: acid_conc must be positive"),
    if not numberp(acid_vol_mL) or acid_vol_mL <= 0 then return("Error: acid_vol_mL must be positive"),
    if not numberp(titrant_conc) or titrant_conc <= 0 then return("Error: titrant_conc must be positive"),
    
    /* Get titration data */
    points: chem_titration_curve_points(acid_formula, acid_conc, acid_vol_mL, titrant_conc),
    
    if is(points = false) then return("Error: Could not generate titration curve"),
    
    /* Calculate equivalence point */
    pKa: chem_acidbase_pKa(acid_formula),
    n_acid: acid_conc * acid_vol_mL,
    V_eq: n_acid / titrant_conc,
    
    /* Build JSON data for Plotly */
    json_points: "[",
    for i: 1 thru length(points) do (
        json_points: sconcat(json_points, "{x: ", float(points[i][1]), ", y: ", float(points[i][2]), "}"),
        if i < length(points) then json_points: sconcat(json_points, ",")
    ),
    json_points: sconcat(json_points, "]"),
    
    /* Generate HTML/JavaScript */
    plot_html: sconcat(
        "<script src='https://cdn.plot.ly/plotly-latest.min.js'></script>",
        "<div id='titrationPlot' style='width:100%;height:500px;'></div>",
        "<script>",
        "var data = [{",
        "  x: ", sconcat("[", apply(sconcat, makelist(sconcat(points[i][1], ","), i, 1, length(points)-1)), points[length(points)][1], "]"),
        ",  y: ", sconcat("[", apply(sconcat, makelist(sconcat(points[i][2], ","), i, 1, length(points)-1)), points[length(points)][2], "]"),
        ",  type: 'scatter',",
        "  mode: 'lines',",
        "  line: {color: 'rgb(0, 0, 255)', width: 2},",
        "  hovertemplate: 'Volume: %{x:.2f} mL<br>pH: %{y:.2f}<extra></extra>'",
        "}];",
        
        "var layout = {",
        "  title: {text: 'Titration Curve: ", acid_formula, " with NaOH'},",
        "  xaxis: {title: 'Volume of NaOH Added (mL)', zeroline: false},",
        "  yaxis: {title: 'pH', zeroline: true, range: [0, 14]},",
        "  plot_bgcolor: 'rgba(240, 240, 240, 0.5)',",
        "  hovermode: 'closest',",
        "  shapes: [{",
        "    type: 'line',",
        "    x0: ", V_eq, ",",
        "    x1: ", V_eq, ",",
        "    y0: 0,",
        "    y1: 14,",
        "    line: {color: 'rgba(255, 0, 0, 0.5)', width: 2, dash: 'dash'}",
        "  }],",
        "  annotations: [{",
        "    x: ", V_eq, ",",
        "    y: 12,",
        "    text: 'Equivalence Point<br>V = ", dispsf(V_eq, 2), " mL<br>pKa = ", dispsf(pKa, 2), "',",
        "    showarrow: true,",
        "    arrowhead: 2,",
        "    bgcolor: 'rgba(255, 255, 255, 0.8)',",
        "    bordercolor: 'red'",
        "  }]",
        "};",
        
        "Plotly.newPlot('titrationPlot', data, layout, {responsive: true});",
        "</script>"
    ),
    
    return(plot_html)
)$

/* Simplified version that returns just the curve data (for analysis) */
chem_titration_equivalence_point(acid_formula, acid_conc, acid_vol_mL, titrant_conc) := block([
    n_acid, V_eq, pKa, pH_eq],
    
    pKa: chem_acidbase_pKa(acid_formula),
    if is(pKa = null) then return(false),
    
    n_acid: acid_conc * acid_vol_mL,
    V_eq: n_acid / titrant_conc,
    
    /* Approximate pH at equivalence point */
    pH_eq: 7 + 0.5 * (pKa + log(acid_vol_mL / (acid_vol_mL + V_eq)) / log(10)),
    
    return([V_eq, pH_eq, pKa])
)$

/* Half-equivalence point (useful for pKa determination) */
chem_titration_half_equivalence_point(acid_formula, acid_conc, acid_vol_mL, titrant_conc) := block([
    V_eq, V_half],
    
    V_eq: first(chem_titration_equivalence_point(acid_formula, acid_conc, acid_vol_mL, titrant_conc)),
    
    if is(V_eq = false) then return(false),
    
    V_half: V_eq / 2,
    pH_half: chem_acidbase_pKa(acid_formula),  /* At half-equivalence, pH = pKa */
    
    return([V_half, pH_half])
)$