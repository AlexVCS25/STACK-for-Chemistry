/* Acid-base database: flat list [acid, pKa, pKb, base, nH, acid, pKa, pKb, base, nH, ...] 
   nH = number of acidic protons for that species */
%_ACIDBASE_DATA: [
    /* Strong acids (pKa < 0) */
    "H3O+", 0, 14, "H2O", 1,
    "HCl", -7.0, 21.0, "Cl-", 1,
    "HBr", -9.0, 23.0, "Br-", 1,
    "HI", -10.0, 24.0, "I-", 1,
    "H2SO4", -2.0, 16.0, "HSO4-", 2,
    "HNO3", -1.0, 15.0, "NO3-", 1,
    "HClO4", -10.0, 24.0, "ClO4-", 1,
    "HClO3", -1.0, 15.0, "ClO3-", 1,
    
    /* Weak acids (pKa > 0) */
    "H2O", 14, 0, "OH-", 1,
    "HSO4-", 1.92, 12.08, "SO4^{2-}", 1,
    "H3PO4", 2.12, 11.88, "H2PO4-", 3,
    "H2PO4-", 7.21, 6.79, "HPO4^{2-}", 2,
    "HPO4^{2-}", 12.32, 1.68, "PO4^{3-}", 1,
    "HF", 3.17, 10.83, "F-", 1,
    "HNO2", 3.25, 10.75, "NO2-", 1,
    "HCOOH", 3.75, 10.25, "HCOO-", 1,
    "C6H5COOH", 4.20, 9.80, "C6H5COO-", 1,
    "CH3COOH", 4.76, 9.24, "CH3COO-", 1,
    "H2CO3", 6.35, 7.65, "HCO3-", 2,
    "HCO3-", 10.33, 3.67, "CO3^{2-}", 1,
    "H2S", 7.00, 7.00, "HS-", 2,
    "HS-", 12.89, 1.11, "S^{2-}", 1,
    "HClO2", 1.94, 12.06, "ClO2-", 1,
    "HClO", 7.53, 6.47, "ClO-", 1,
    "HBrO", 8.59, 5.41, "BrO-", 1,
    "HIO", 10.64, 3.36, "IO-", 1,
    "HCN", 9.21, 4.79, "CN-", 1,
    "NH4+", 9.25, 4.75, "NH3", 1,
    "H2O2", 11.62, 2.38, "HO2-", 2,
    "C6H5OH", 9.95, 4.05, "C6H5O-", 1,
    "H3BO3", 9.24, 4.76, "H2BO3-", 3,
    "H2SiO3", 9.77, 4.23, "HSiO3-", 2,
    "HSiO3-", 11.80, 2.20, "SiO3^{2-}", 1,
    "H2C2O4", 1.25, 12.75, "HC2O4-", 2,
    "HC2O4-", 4.27, 9.73, "C2O4^{2-}", 1,
    "H2SO3", 1.81, 12.19, "HSO3-", 2,
    "HSO3-", 6.91, 7.09, "SO3^{2-}", 1,
    "H3AsO4", 2.22, 11.78, "H2AsO4-", 3,
    "H2AsO4-", 6.98, 7.02, "HAsO4^{2-}", 2,
    "HAsO4^{2-}", 11.50, 2.50, "AsO4^{3-}", 1,
    "H2CrO4", 0.74, 13.26, "HCrO4-", 2,
    "HCrO4-", 6.49, 7.51, "CrO4^{2-}", 1,
    "CH3NH3+", 10.64, 3.36, "CH3NH2", 1,
    "(CH3)2NH2+", 10.73, 3.27, "(CH3)2NH", 1,
    "(CH3)3NH+", 9.80, 4.20, "(CH3)3N", 1,
    "C2H5NH3+", 10.81, 3.19, "C2H5NH2", 1,
    "C6H5NH3+", 4.63, 9.37, "C6H5NH2", 1,
    "N2H5+", 8.07, 5.93, "N2H4", 1,
    "HONH3+", 5.96, 8.04, "HONH2", 1,
    "H2NCONH3+", 0.18, 13.82, "H2NCONH2", 1,
    "C5H5NH+", 5.23, 8.77, "C5H5N", 1
]$

/* Helper: find index of acid (returns position of acid, or 0 if not found) */
_acidbase_find_acid(acid) := block([i, n, result],
    n: length(%_ACIDBASE_DATA),
    result: 0,
    i: 1,
    while i <= n do (
        if is(%_ACIDBASE_DATA[i] = acid) then (result: i, return(result)),
        i: i + 5
    ),
    result
)$

/* Helper: find index of base (returns starting position of entry, or 0 if not found) */
_acidbase_find_base(base) := block([i, n, result],
    n: length(%_ACIDBASE_DATA),
    result: 0,
    i: 4,
    while i <= n do (
        if is(%_ACIDBASE_DATA[i] = base) then (result: i - 3, return(result)),
        i: i + 5
    ),
    result
)$

/* Get pKa for an ACID - acid is at idx, pKa is at idx+1 */
chem_acidbase_pKa(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 1]
)$

/* Get pKb for a BASE - find entry via base, pKb is at idx+2 */
chem_acidbase_pKb(base) := block([idx],
    idx: _acidbase_find_base(base),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 2]
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if is(pKa = null) then null
    else if not numberp(pKa) then null
    else 10^(-pKa)
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if is(pKb = null) then null
    else if not numberp(pKb) then null
    else 10^(-pKb)
)$

/* Get number of acidic protons for an acid */
chem_acidbase_nH(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then null else %_ACIDBASE_DATA[idx + 4]
)$

/* Get conjugate base for an acid - acid at idx, base at idx+3 */
chem_acidbase_conjugate_base(acid) := block([idx],
    idx: _acidbase_find_acid(acid),
    if is(idx = 0) then "" else %_ACIDBASE_DATA[idx + 3]
)$

/* Get conjugate acid for a base - entry starts at idx, acid at idx */
chem_acidbase_conjugate_acid(base) := block([idx],
    idx: _acidbase_find_base(base),
    if is(idx = 0) then "" else %_ACIDBASE_DATA[idx]
)$

/* Navigation arrays */

/* All acids */
chem_acid_array() := block([result, i, n],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* All bases */
chem_base_array() := block([result, i, n],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 4,
    while i <= n do (
        result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Strong acids: pKa < 0 */
chem_strong_acid_array() := block([result, i, n, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        if numberp(pKa) and is(pKa < 0) then result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Weak acids: pKa > 0 */
chem_weak_acid_array() := block([result, i, n, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        if numberp(pKa) and is(pKa > 0) then result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Strong bases: pKb <= 0 */
chem_strong_base_array() := block([result, i, n, pKb],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKb: %_ACIDBASE_DATA[i + 2],
        if numberp(pKb) and is(pKb <= 0) then result: append(result, [%_ACIDBASE_DATA[i + 3]]),
        i: i + 5
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 */
chem_weak_base_array() := block([result, i, n, pKb],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKb: %_ACIDBASE_DATA[i + 2],
        if numberp(pKb) and is(pKb > 0) and is(pKb < 14) then result: append(result, [%_ACIDBASE_DATA[i + 3]]),
        i: i + 5
    ),
    result
)$

/* Acids with specific number of acidic protons */
chem_acid_array_nH(nH_target) := block([result, i, n, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(nH) and is(nH = nH_target) then result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Strong acids with specific number of acidic protons */
chem_strong_acid_array_nH(nH_target) := block([result, i, n, pKa, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(pKa) and is(pKa < 0) and numberp(nH) and is(nH = nH_target) then 
            result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Weak acids with specific number of acidic protons */
chem_weak_acid_array_nH(nH_target) := block([result, i, n, pKa, nH],
    n: length(%_ACIDBASE_DATA),
    result: [],
    i: 1,
    while i <= n do (
        pKa: %_ACIDBASE_DATA[i + 1],
        nH: %_ACIDBASE_DATA[i + 4],
        if numberp(pKa) and is(pKa > 0) and numberp(nH) and is(nH = nH_target) then 
            result: append(result, [%_ACIDBASE_DATA[i]]),
        i: i + 5
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$

/****************************************************************/
/*                                                              */
/*  Titration Curve Functions for Polyprotic Acids              */
/*  Using Alpha Fractions and Charge Balance                    */
/*                                                              */
/****************************************************************/

/* Get all pKa values for a polyprotic acid as a list */
chem_acidbase_pKa_list(acid) := block([pKa_values, current_acid, current_pKa, current_base, max_iter],
    pKa_values: [],
    current_acid: acid,
    max_iter: 5,
    
    while max_iter > 0 and not is(current_acid = "") and not is(current_acid = null) do (
        current_pKa: chem_acidbase_pKa(current_acid),
        if is(current_pKa = null) then return(pKa_values),
        pKa_values: append(pKa_values, [current_pKa]),
        current_base: chem_acidbase_conjugate_base(current_acid),
        if is(current_base = "") or is(current_base = null) then return(pKa_values),
        current_acid: current_base,
        max_iter: max_iter - 1
    ),
    return(pKa_values)
)$

/* Convert pKa list to Ka list */
_pKa_to_Ka(pKa_list) := block([Ka_list, idx],
    Ka_list: [],
    idx: 1,
    while idx <= length(pKa_list) do (
        Ka_list: append(Ka_list, [float(10^(-pKa_list[idx]))]),
        idx: idx + 1
    ),
    return(Ka_list)
)$

/* Calculate alpha fractions - OPTIMIZED */
_alpha_fractions(H, Ka_list) := block([n, D, alphas, prod, idx, Hn],
    n: length(Ka_list),
    Hn: float(H^n),
    
    /* Build denominator */
    D: Hn,
    prod: 1.0,
    idx: 1,
    while idx <= n do (
        prod: prod * Ka_list[idx],
        D: D + prod * float(H^(n - idx)),
        idx: idx + 1
    ),
    
    if is(D < 1e-50) then D: 1e-50,
    
    /* Calculate alphas */
    alphas: [Hn / D],
    prod: 1.0,
    idx: 1,
    while idx <= n do (
        prod: prod * Ka_list[idx],
        alphas: append(alphas, [prod * float(H^(n - idx)) / D]),
        idx: idx + 1
    ),
    
    return(alphas)
)$

/* Calculate derivative of alpha fractions with respect to H
   Returns d(alphas)/dH for Newton-Raphson optimization */
_alpha_fractions_derivative(H, Ka_list) := block([n, D, dD, alphas, dalphas, prod, idx, Hn],
    n: length(Ka_list),
    Hn: float(H^n),
    
    /* Build denominator D and its derivative dD/dH */
    D: Hn,
    dD: n * float(H^(n-1)),
    prod: 1.0,
    idx: 1,
    while idx <= n do (
        prod: prod * Ka_list[idx],
        D: D + prod * float(H^(n - idx)),
        if is(n - idx > 0) then 
            dD: dD + prod * (n - idx) * float(H^(n - idx - 1))
        else
            dD: dD,
        idx: idx + 1
    ),
    
    if is(D < 1e-50) then D: 1e-50,
    
    /* Calculate alphas and their derivatives using quotient rule */
    /* d/dH [f/D] = (f'*D - f*D') / D^2 */
    alphas: [],
    dalphas: [],
    prod: 1.0,
    idx: 0,
    while idx <= n do (
        if is(idx > 0) then prod: prod * Ka_list[idx],
        block([f, df, alpha, dalpha],
            f: prod * float(H^(n - idx)),
            if is(n - idx > 0) then 
                df: prod * (n - idx) * float(H^(n - idx - 1))
            else
                df: 0,
            alpha: f / D,
            dalpha: (df * D - f * dD) / (D * D),
            alphas: append(alphas, [alpha]),
            dalphas: append(dalphas, [dalpha])
        ),
        idx: idx + 1
    ),
    
    return([alphas, dalphas])
)$

/* Charge balance equation - OPTIMIZED */
_charge_balance(H, CT, CB, Ka_list, Kw) := block([alphas, neg_charge, idx, n],
    alphas: _alpha_fractions(H, Ka_list),
    n: length(Ka_list),
    
    neg_charge: 0.0,
    idx: 1,
    while idx <= n do (
        neg_charge: neg_charge + idx * alphas[idx + 1],
        idx: idx + 1
    ),
    
    return(float(H + CB - Kw/H - CT * neg_charge))
)$

/* Charge balance equation and its derivative for Newton-Raphson
   Returns [f(H), f'(H)] */
_charge_balance_with_derivative(H, CT, CB, Ka_list, Kw) := block(
    [alpha_data, alphas, dalphas, neg_charge, dneg_charge, idx, n, f, df],
    
    alpha_data: _alpha_fractions_derivative(H, Ka_list),
    alphas: first(alpha_data),
    dalphas: second(alpha_data),
    n: length(Ka_list),
    
    /* Sum of i * alpha_i and its derivative */
    neg_charge: 0.0,
    dneg_charge: 0.0,
    idx: 1,
    while idx <= n do (
        neg_charge: neg_charge + idx * alphas[idx + 1],
        dneg_charge: dneg_charge + idx * dalphas[idx + 1],
        idx: idx + 1
    ),
    
    /* f(H) = H + CB - Kw/H - CT * neg_charge */
    f: H + CB - Kw/H - CT * neg_charge,
    
    /* f'(H) = 1 + Kw/H^2 - CT * dneg_charge */
    df: 1 + Kw/(H*H) - CT * dneg_charge,
    
    return([float(f), float(df)])
)$

/* Solve for pH using bisection - OPTIMIZED with fewer iterations */
_solve_pH(CT, CB, Ka_list) := block([Kw, H_lo, H_hi, H_mid, f_lo, f_hi, f_mid, iter],
    Kw: 1.0e-14,
    
    H_lo: 1e-14,
    H_hi: 1.0,
    
    f_lo: _charge_balance(H_lo, CT, CB, Ka_list, Kw),
    f_hi: _charge_balance(H_hi, CT, CB, Ka_list, Kw),
    
    /* Only 40 iterations - sufficient for ~12 decimal places */
    iter: 0,
    while iter < 40 do (
        H_mid: (H_lo + H_hi) / 2.0,
        f_mid: _charge_balance(H_mid, CT, CB, Ka_list, Kw),
        
        if is(abs(f_mid) < 1e-10) then return(float(-log(H_mid) / log(10))),
        
        if is(f_mid * f_hi < 0) then (
            H_lo: H_mid
        ) else (
            H_hi: H_mid
        ),
        
        iter: iter + 1
    ),
    
    return(float(-log(H_mid) / log(10)))
)$

/* Hybrid solver: Bisektion for initial bracketing, then Newton-Raphson for speed
   Much faster and more accurate than pure bisection */
_solve_pH(CT, CB, Ka_list) := block(
    [Kw, H_lo, H_hi, H, f, df, f_data, iter, converged, H_new],
    Kw: 1.0e-14,
    
    /* Initial bracket: pH 0 to 14 */
    H_lo: 1e-14,
    H_hi: 1.0,
    
    /* Start with a few bisection steps to get into the right region */
    iter: 0,
    while iter < 10 do (
        H: (H_lo + H_hi) / 2.0,
        f: _charge_balance(H, CT, CB, Ka_list, Kw),
        
        if is(f * _charge_balance(H_hi, CT, CB, Ka_list, Kw) < 0) then
            H_lo: H
        else
            H_hi: H,
        iter: iter + 1
    ),
    
    /* Now use Newton-Raphson for fast convergence */
    H: (H_lo + H_hi) / 2.0,
    converged: false,
    iter: 0,
    
    while iter < 20 and not converged do (
        f_data: _charge_balance_with_derivative(H, CT, CB, Ka_list, Kw),
        f: first(f_data),
        df: second(f_data),
        
        /* Check convergence */
        if is(abs(f) < 1e-12) then (
            converged: true
        ) else (
            /* Newton step with safeguard */
            if is(abs(df) > 1e-30) then (
                H_new: H - f/df,
                /* Keep within bounds */
                if is(H_new < H_lo) or is(H_new > H_hi) then
                    H_new: (H_lo + H_hi) / 2.0,
                /* Update bounds based on sign of f */
                if is(f > 0) then H_lo: H else H_hi: H,
                H: H_new
            ) else (
                /* Fallback to bisection if derivative too small */
                H: (H_lo + H_hi) / 2.0
            )
        ),
        iter: iter + 1
    ),
    
    return(float(-log(H) / log(10)))
)$

/* Calculate pH at a given point during titration */
chem_titration_pH(acid, c_acid, c_base, v_acid, v_base) := block(
    [pKa_list, Ka_list, v_total, CT, CB, pH],
    
    pKa_list: chem_acidbase_pKa_list(acid),
    if is(length(pKa_list) = 0) then return(false),
    Ka_list: _pKa_to_Ka(pKa_list),
    
    v_total: float((v_acid + v_base) / 1000.0),
    CT: float((c_acid * v_acid / 1000.0) / v_total),
    CB: float((c_base * v_base / 1000.0) / v_total),
    
    pH: _solve_pH(CT, CB, Ka_list),
    
    if is(pH < 0) then pH: 0.0,
    if is(pH > 14) then pH: 14.0,
    
    return(pH)
)$

/* Generate titration curve data - use fewer points by default */
chem_titration_curve_data(acid, c_acid, c_base, v_acid, n_points) := block(
    [num_protons, v_final_equiv, v_max, data, v, pH, idx, delta_v],
    
    num_protons: length(chem_acidbase_pKa_list(acid)),
    if is(num_protons = 0) then num_protons: 1,
    
    v_final_equiv: float((num_protons * c_acid * v_acid) / c_base),
    v_max: float(v_final_equiv * 1.2),
    delta_v: float(v_max / (n_points - 1)),
    
    data: [],
    idx: 0,
    
    while idx < n_points do (
        v: float(idx * delta_v),
        pH: chem_titration_pH(acid, c_acid, c_base, v_acid, v),
        if not is(pH = false) then data: append(data, [[v, pH]]),
        idx: idx + 1
    ),
    
    return(data)
)$

/* Convert titration data to JSXGraph-compatible JavaScript array string 
   Rounds values to 3 decimal places for cleaner output */
chem_titration_jsxgraph_points(data) := block([result, idx, pair, vv, pp],
    result: "[",
    idx: 1,
    while idx <= length(data) do (
        pair: data[idx],
        /* Round to 3 decimal places */
        vv: float(round(1000 * first(pair)) / 1000),
        pp: float(round(1000 * second(pair)) / 1000),
        result: sconcat(result, "[", string(vv), ",", string(pp), "]"),
        if is(idx < length(data)) then result: sconcat(result, ","),
        idx: idx + 1
    ),
    result: sconcat(result, "]"),
    return(result)
)$

/* NEW: Return X-values as a Maxima list (not a string) for direct JSXGraph use */
chem_titration_xdata(data) := block([result, idx],
    result: [],
    idx: 1,
    while idx <= length(data) do (
        result: append(result, [float(round(1000 * first(data[idx])) / 1000)]),
        idx: idx + 1
    ),
    return(result)
)$

/* NEW: Return Y-values (pH) as a Maxima list (not a string) for direct JSXGraph use */
chem_titration_ydata(data) := block([result, idx],
    result: [],
    idx: 1,
    while idx <= length(data) do (
        result: append(result, [float(round(1000 * second(data[idx])) / 1000)]),
        idx: idx + 1
    ),
    return(result)
)$

/* Get the i-th equivalence point volume (in mL) */
chem_titration_equiv_volume(c_acid, c_base, v_acid, i) := block([],
    if not integerp(i) then i: 1,
    if is(i < 1) then i: 1,
    float((i * c_acid * v_acid) / c_base)
)$

/* Get the pH at the i-th equivalence point */
chem_titration_equiv_pH(acid, c_acid, c_base, v_acid, i) := block([v_equiv],
    if not integerp(i) then i: 1,
    v_equiv: chem_titration_equiv_volume(c_acid, c_base, v_acid, i),
    chem_titration_pH(acid, c_acid, c_base, v_acid, v_equiv)
)$

/* Get the pH at the i-th half-equivalence point */
chem_titration_half_equiv_pH(acid, c_acid, c_base, v_acid, i) := block([v_half, prev_equiv],
    if not integerp(i) then i: 1,
    if is(i < 1) then i: 1,
    
    if is(i = 1) then (
        prev_equiv: 0
    ) else (
        prev_equiv: chem_titration_equiv_volume(c_acid, c_base, v_acid, i - 1)
    ),
    v_half: (prev_equiv + chem_titration_equiv_volume(c_acid, c_base, v_acid, i)) / 2,
    chem_titration_pH(acid, c_acid, c_base, v_acid, v_half)
)$

/* Get list of all equivalence volumes for a polyprotic acid (in mL) */
chem_titration_equiv_volumes(acid, c_acid, c_base, v_acid) := block([num_protons, volumes, idx],
    num_protons: length(chem_acidbase_pKa_list(acid)),
    if is(num_protons = 0) then return([]),
    
    volumes: [],
    idx: 1,
    while idx <= num_protons do (
        volumes: append(volumes, [chem_titration_equiv_volume(c_acid, c_base, v_acid, idx)]),
        idx: idx + 1
    ),
    return(volumes)
)$

/* Get list of all pKa values for plotting reference lines */
chem_titration_pKa_values(acid) := chem_acidbase_pKa_list(acid)$

/* Get the number of protons for an acid */
chem_acidbase_num_protons(acid) := block([nH],
    nH: chem_acidbase_nH(acid),
    if is(nH = null) then 1 else nH
)$