    Simplified, robust acid-base helper.
*/

/* Acid-base database using assoc-compatible format: [acid, [pKa, pKb, base]] */
%_ACIDBASE_DATA: [
    ["H3O+", [0, 14, "H2O"]],
    ["H2O", [14, 0, "OH-"]],
    ["HCl", [-7.0, 21.0, "Cl-"]],
    ["H2SO4", [-2.0, 16.0, "HSO4-"]],
    ["HSO4-", [1.92, 12.08, "SO4^{2-}"]],
    ["HNO3", [-1, 15, "NO3-"]],
    ["H3PO4", [2.12, 11.88, "H2PO4-"]],
    ["H2PO4-", [7.21, 6.79, "HPO4^{2-}"]],
    ["HPO4^{2-}", [12.32, 1.68, "PO4^{3-}"]],
    ["HF", [3.17, 10.83, "F-"]],
    ["CH3COOH", [4.74, 9.26, "CH3COO-"]],
    ["H2CO3", [6.35, 7.65, "HCO3-"]],
    ["HCO3-", [10.33, 3.67, "CO3^{2-}"]],
    ["H2S", [7.00, 7.00, "HS-"]],
    ["HS-", [12.89, 1.11, "S^{2-}"]],
    ["NH4+", [9.25, 4.75, "NH3"]]
]$

/* Reverse lookup table: [base, [pKa, pKb, acid]] for base lookups */
%_ACIDBASE_DATA_REV: [
    ["H2O", [0, 14, "H3O+"]],
    ["OH-", [14, 0, "H2O"]],
    ["Cl-", [-7.0, 21.0, "HCl"]],
    ["HSO4-", [-2.0, 16.0, "H2SO4"]],
    ["SO4^{2-}", [1.92, 12.08, "HSO4-"]],
    ["NO3-", [-1, 15, "HNO3"]],
    ["H2PO4-", [2.12, 11.88, "H3PO4"]],
    ["HPO4^{2-}", [7.21, 6.79, "H2PO4-"]],
    ["PO4^{3-}", [12.32, 1.68, "HPO4^{2-}"]],
    ["F-", [3.17, 10.83, "HF"]],
    ["CH3COO-", [4.74, 9.26, "CH3COOH"]],
    ["HCO3-", [6.35, 7.65, "H2CO3"]],
    ["CO3^{2-}", [10.33, 3.67, "HCO3-"]],
    ["HS-", [7.00, 7.00, "H2S"]],
    ["S^{2-}", [12.89, 1.11, "HS-"]],
    ["NH3", [9.25, 4.75, "NH4+"]]
]$

/* Get all data for an ACID: returns [pKa, pKb, base] or false */
chem_acidbase_acid_data(acid) := assoc(acid, %_ACIDBASE_DATA)$

/* Get all data for a BASE: returns [pKa, pKb, acid] or false */
chem_acidbase_base_data(base) := assoc(base, %_ACIDBASE_DATA_REV)$

/* Get pKa for an ACID */
chem_acidbase_pKa(acid) := block([data],
    data: chem_acidbase_acid_data(acid),
    if is(data = false) then null else first(data)
)$

/* Get pKb for a BASE */
chem_acidbase_pKb(base) := block([data],
    data: chem_acidbase_base_data(base),
    if is(data = false) then null else second(data)
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if is(pKa = null) then null
    else if not numberp(pKa) then null
    else 10^(-pKa)
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if is(pKb = null) then null
    else if not numberp(pKb) then null
    else 10^(-pKb)
)$

/* Get conjugate base for an acid */
chem_acidbase_conjugate_base(acid) := block([data],
    data: chem_acidbase_acid_data(acid),
    if is(data = false) then "" else third(data)
)$

/* Get conjugate acid for a base */
chem_acidbase_conjugate_acid(base) := block([data],
    data: chem_acidbase_base_data(base),
    if is(data = false) then "" else third(data)
)$

/* Basic helper for formula display */
chem_display(substance) := sconcat("\\ce{", substance, "}")$

/* Navigation arrays */

/* All acids */
chem_acid_array() := map(first, %_ACIDBASE_DATA)$

/* All bases */
chem_base_array() := map(first, %_ACIDBASE_DATA_REV)$

/* Strong acids: pKa < 0 */
chem_strong_acid_array() := block([result, entry, pKa],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        pKa: first(second(entry)),
        if numberp(pKa) and is(pKa < 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Weak acids: pKa > 0 */
chem_weak_acid_array() := block([result, entry, pKa],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        pKa: first(second(entry)),
        if numberp(pKa) and is(pKa > 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Strong bases: pKb <= 0 */
chem_strong_base_array() := block([result, entry, pKb],
    result: [],
    for entry in %_ACIDBASE_DATA_REV do (
        pKb: second(second(entry)),
        if numberp(pKb) and is(pKb <= 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 */
chem_weak_base_array() := block([result, entry, pKb],
    result: [],
    for entry in %_ACIDBASE_DATA_REV do (
        pKb: second(second(entry)),
        if numberp(pKb) and is(pKb > 0) and is(pKb < 14) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$