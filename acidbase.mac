    Simplified, robust acid-base helper.
*/

/* Acid-base database: [acid, pKa, pKb, base]
   pKa: acidic dissociation constant of the acid
   pKb: basic dissociation constant of the conjugate base (pKb = 14 - pKa)
   Empty string "" for base means no conjugate base defined */
%_ACIDBASE_DATA: [
    ["H3O+", 0, 14, "H2O"],
    ["H2O", 14, 0, "OH-"],
    ["HCl", -7.0, 21.0, "Cl-"],
    ["H2SO4", -2.0, 16.0, "HSO4-"],
    ["HSO4-", 1.92, 12.08, "SO4^{2-}"],
    ["HNO3", -1, 15, "NO3-"],
    ["H3PO4", 2.12, 11.88, "H2PO4-"],
    ["H2PO4-", 7.21, 6.79, "HPO4^{2-}"],
    ["HPO4^{2-}", 12.32, 1.68, "PO4^{3-}"],
    ["HF", 3.17, 10.83, "F-"],
    ["CH3COOH", 4.74, 9.26, "CH3COO-"],
    ["H2CO3", 6.35, 7.65, "HCO3-"],
    ["HCO3-", 10.33, 3.67, "CO3^{2-}"],
    ["H2S", 7.00, 7.00, "HS-"],
    ["HS-", 12.89, 1.11, "S^{2-}"],
    ["NH4+", 9.25, 4.75, "NH3"]
]$

/* Get pKa for an ACID (looks up column 1, returns column 2) */
chem_acidbase_pKa(acid) := block([i, n, entry],
    n: length(%_ACIDBASE_DATA),
    for i: 1 thru n do (
        entry: %_ACIDBASE_DATA[i],
        if is(entry[1] = acid) then return(entry[2])
    ),
    return(null)
)$

/* Get pKb for a BASE (looks up column 4, returns column 3) */
chem_acidbase_pKb(base) := block([i, n, entry],
    n: length(%_ACIDBASE_DATA),
    for i: 1 thru n do (
        entry: %_ACIDBASE_DATA[i],
        if is(entry[4] = base) then return(entry[3])
    ),
    return(null)
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if not numberp(pKa) then return(null) else return(10^(-pKa))
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if not numberp(pKb) then return(null) else return(10^(-pKb))
)$

/* Get conjugate base for an acid (looks up column 1, returns column 4) */
chem_acidbase_conjugate_base(acid) := block([i, n, entry],
    n: length(%_ACIDBASE_DATA),
    for i: 1 thru n do (
        entry: %_ACIDBASE_DATA[i],
        if is(entry[1] = acid) then return(entry[4])
    ),
    return("")
)$

/* Get conjugate acid for a base (looks up column 4, returns column 1) */
chem_acidbase_conjugate_acid(base) := block([i, n, entry],
    n: length(%_ACIDBASE_DATA),
    for i: 1 thru n do (
        entry: %_ACIDBASE_DATA[i],
        if is(entry[4] = base) then return(entry[1])
    ),
    return("")
)$

/* Basic helper for formula display */
chem_display(substance) := sconcat("\\ce{", substance, "}")$

/* Navigation arrays */

/* All acids (column 1) */
chem_acid_array() := block([i, n, result],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        result: append(result, [%_ACIDBASE_DATA[i][1]])
    ),
    result
)$

/* All bases (column 4), excluding empty strings */
chem_base_array() := block([i, n, result, base],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        base: %_ACIDBASE_DATA[i][4],
        if not is(base = "") then
            result: append(result, [base])
    ),
    result
)$

/* Strong acids: pKa < 0 (returns column 1) */
chem_strong_acid_array() := block([i, n, result, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        pKa: %_ACIDBASE_DATA[i][2],
        if numberp(pKa) and pKa < 0 then
            result: append(result, [%_ACIDBASE_DATA[i][1]])
    ),
    result
)$

/* Weak acids: pKa > 0 (returns column 1) */
chem_weak_acid_array() := block([i, n, result, pKa],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        pKa: %_ACIDBASE_DATA[i][2],
        if numberp(pKa) and pKa > 0 then
            result: append(result, [%_ACIDBASE_DATA[i][1]])
    ),
    result
)$

/* Strong bases: pKb <= 0 (returns column 4) */
chem_strong_base_array() := block([i, n, result, pKb, base],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        base: %_ACIDBASE_DATA[i][4],
        pKb: %_ACIDBASE_DATA[i][3],
        if not is(base = "") and numberp(pKb) and pKb <= 0 then
            result: append(result, [base])
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 (returns column 4) */
chem_weak_base_array() := block([i, n, result, pKb, base],
    n: length(%_ACIDBASE_DATA),
    result: [],
    for i: 1 thru n do (
        base: %_ACIDBASE_DATA[i][4],
        pKb: %_ACIDBASE_DATA[i][3],
        if not is(base = "") and numberp(pKb) and pKb > 0 and pKb < 14 then
            result: append(result, [base])
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$