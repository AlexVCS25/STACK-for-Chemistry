    Simplified, robust acid-base helper.
*/

/* Acid-base database: [acid, pKa, pKb, base]
   pKa: acidic dissociation constant of the acid
   pKb: basic dissociation constant of the conjugate base (pKb = 14 - pKa)
   Empty string "" for base means no conjugate base defined */
%_ACIDBASE_DATA: [
    ["H3O+", 0, 14, "H2O"],
    ["H2O", 14, 0, "OH-"],
    ["HCl", -7.0, 21.0, "Cl-"],
    ["H2SO4", -2.0, 16.0, "HSO4-"],
    ["HSO4-", 1.92, 12.08, "SO4^{2-}"],
    ["HNO3", -1, 15, "NO3-"],
    ["H3PO4", 2.12, 11.88, "H2PO4-"],
    ["H2PO4-", 7.21, 6.79, "HPO4^{2-}"],
    ["HPO4^{2-}", 12.32, 1.68, "PO4^{3-}"],
    ["HF", 3.17, 10.83, "F-"],
    ["CH3COOH", 4.74, 9.26, "CH3COO-"],
    ["H2CO3", 6.35, 7.65, "HCO3-"],
    ["HCO3-", 10.33, 3.67, "CO3^{2-}"],
    ["H2S", 7.00, 7.00, "HS-"],
    ["HS-", 12.89, 1.11, "S^{2-}"],
    ["NH4+", 9.25, 4.75, "NH3"]
]$

/* Get pKa for an ACID (column 1 -> column 2) */
chem_acidbase_pKa(acid) := block([entry],
    for entry in %_ACIDBASE_DATA do (
        if sequal(first(entry), acid) then return(second(entry))
    ),
    return(null)
)$

/* Get pKb for a BASE (column 4 -> column 3) */
chem_acidbase_pKb(base) := block([entry],
    for entry in %_ACIDBASE_DATA do (
        if sequal(fourth(entry), base) then return(third(entry))
    ),
    return(null)
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if not numberp(pKa) then return(null) else return(10^(-pKa))
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if not numberp(pKb) then return(null) else return(10^(-pKb))
)$

/* Get conjugate base for an acid */
chem_acidbase_conjugate_base(acid) := block([entry],
    for entry in %_ACIDBASE_DATA do (
        if sequal(first(entry), acid) then return(fourth(entry))
    ),
    return("")
)$

/* Get conjugate acid for a base */
chem_acidbase_conjugate_acid(base) := block([entry],
    for entry in %_ACIDBASE_DATA do (
        if sequal(fourth(entry), base) then return(first(entry))
    ),
    return("")
)$

/* Basic helper for formula display */
chem_display(substance) := sconcat("\\ce{", substance, "}")$

/* Navigation arrays */

/* All acids (column 1) */
chem_acid_array() := map(first, %_ACIDBASE_DATA)$

/* All bases (column 4), excluding empty strings */
chem_base_array() := block([result, entry],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        if not sequal(fourth(entry), "") then
            result: append(result, [fourth(entry)])
    ),
    result
)$

/* Strong acids: pKa < 0 */
chem_strong_acid_array() := block([result, entry],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        if numberp(second(entry)) and second(entry) < 0 then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Weak acids: pKa > 0 */
chem_weak_acid_array() := block([result, entry],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        if numberp(second(entry)) and second(entry) > 0 then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Strong bases: pKb <= 0 */
chem_strong_base_array() := block([result, entry],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        if not sequal(fourth(entry), "") and numberp(third(entry)) and third(entry) <= 0 then
            result: append(result, [fourth(entry)])
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 */
chem_weak_base_array() := block([result, entry],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        if not sequal(fourth(entry), "") and numberp(third(entry)) and third(entry) > 0 and third(entry) < 14 then
            result: append(result, [fourth(entry)])
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$