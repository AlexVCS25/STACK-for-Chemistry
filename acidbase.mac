/* Acid-base database using assoc-compatible format: [acid, [pKa, pKb, base]] */
%_ACIDBASE_DATA: [
    /* Strong acids (pKa < 0) */
    ["H3O+", [0, 14, "H2O"]],
    ["HCl", [-7.0, 21.0, "Cl-"]],
    ["HBr", [-9.0, 23.0, "Br-"]],
    ["HI", [-10.0, 24.0, "I-"]],
    ["H2SO4", [-2.0, 16.0, "HSO4-"]],
    ["HNO3", [-1.0, 15.0, "NO3-"]],
    ["HClO4", [-10.0, 24.0, "ClO4-"]],
    ["HClO3", [-1.0, 15.0, "ClO3-"]],
    
    /* Weak acids (pKa > 0) */
    ["H2O", [14, 0, "OH-"]],
    ["HSO4-", [1.92, 12.08, "SO4^{2-}"]],
    ["H3PO4", [2.12, 11.88, "H2PO4-"]],
    ["H2PO4-", [7.21, 6.79, "HPO4^{2-}"]],
    ["HPO4^{2-}", [12.32, 1.68, "PO4^{3-}"]],
    ["HF", [3.17, 10.83, "F-"]],
    ["HNO2", [3.25, 10.75, "NO2-"]],
    ["HCOOH", [3.75, 10.25, "HCOO-"]],
    ["C6H5COOH", [4.20, 9.80, "C6H5COO-"]],
    ["CH3COOH", [4.76, 9.24, "CH3COO-"]],
    ["H2CO3", [6.35, 7.65, "HCO3-"]],
    ["HCO3-", [10.33, 3.67, "CO3^{2-}"]],
    ["H2S", [7.00, 7.00, "HS-"]],
    ["HS-", [12.89, 1.11, "S^{2-}"]],
    ["HClO2", [1.94, 12.06, "ClO2-"]],
    ["HClO", [7.53, 6.47, "ClO-"]],
    ["HBrO", [8.59, 5.41, "BrO-"]],
    ["HIO", [10.64, 3.36, "IO-"]],
    ["HCN", [9.21, 4.79, "CN-"]],
    ["NH4+", [9.25, 4.75, "NH3"]],
    ["H2O2", [11.62, 2.38, "HO2-"]],
    ["C6H5OH", [9.95, 4.05, "C6H5O-"]],
    ["H3BO3", [9.24, 4.76, "H2BO3-"]],
    ["H2SiO3", [9.77, 4.23, "HSiO3-"]],
    ["HSiO3-", [11.80, 2.20, "SiO3^{2-}"]],
    ["H2C2O4", [1.25, 12.75, "HC2O4-"]],
    ["HC2O4-", [4.27, 9.73, "C2O4^{2-}"]],
    ["H2SO3", [1.81, 12.19, "HSO3-"]],
    ["HSO3-", [6.91, 7.09, "SO3^{2-}"]],
    ["H3AsO4", [2.22, 11.78, "H2AsO4-"]],
    ["H2AsO4-", [6.98, 7.02, "HAsO4^{2-}"]],
    ["HAsO4^{2-}", [11.50, 2.50, "AsO4^{3-}"]],
    ["H2CrO4", [0.74, 13.26, "HCrO4-"]],
    ["HCrO4-", [6.49, 7.51, "CrO4^{2-}"]],
    ["CH3NH3+", [10.64, 3.36, "CH3NH2"]],
    ["(CH3)2NH2+", [10.73, 3.27, "(CH3)2NH"]],
    ["(CH3)3NH+", [9.80, 4.20, "(CH3)3N"]],
    ["C2H5NH3+", [10.81, 3.19, "C2H5NH2"]],
    ["C6H5NH3+", [4.63, 9.37, "C6H5NH2"]],
    ["N2H5+", [8.07, 5.93, "N2H4"]],
    ["HONH3+", [5.96, 8.04, "HONH2"]],
    ["H2NCONH3+", [0.18, 13.82, "H2NCONH2"]],
    ["C5H5NH+", [5.23, 8.77, "C5H5N"]]
]$

/* Reverse lookup table: [base, [pKa, pKb, acid]] for base lookups */
%_ACIDBASE_DATA_REV: [
    /* Strong bases (pKb <= 0) */
    ["H2O", [0, 14, "H3O+"]],
    ["OH-", [14, 0, "H2O"]],
    ["Cl-", [-7.0, 21.0, "HCl"]],
    ["Br-", [-9.0, 23.0, "HBr"]],
    ["I-", [-10.0, 24.0, "HI"]],
    ["ClO4-", [-10.0, 24.0, "HClO4"]],
    ["ClO3-", [-1.0, 15.0, "HClO3"]],
    ["NO3-", [-1.0, 15.0, "HNO3"]],
    
    /* Weak bases (0 < pKb < 14) */
    ["HSO4-", [-2.0, 16.0, "H2SO4"]],
    ["SO4^{2-}", [1.92, 12.08, "HSO4-"]],
    ["H2PO4-", [2.12, 11.88, "H3PO4"]],
    ["HPO4^{2-}", [7.21, 6.79, "H2PO4-"]],
    ["PO4^{3-}", [12.32, 1.68, "HPO4^{2-}"]],
    ["F-", [3.17, 10.83, "HF"]],
    ["NO2-", [3.25, 10.75, "HNO2"]],
    ["HCOO-", [3.75, 10.25, "HCOOH"]],
    ["C6H5COO-", [4.20, 9.80, "C6H5COOH"]],
    ["CH3COO-", [4.76, 9.24, "CH3COOH"]],
    ["HCO3-", [6.35, 7.65, "H2CO3"]],
    ["CO3^{2-}", [10.33, 3.67, "HCO3-"]],
    ["HS-", [7.00, 7.00, "H2S"]],
    ["S^{2-}", [12.89, 1.11, "HS-"]],
    ["ClO2-", [1.94, 12.06, "HClO2"]],
    ["ClO-", [7.53, 6.47, "HClO"]],
    ["BrO-", [8.59, 5.41, "HBrO"]],
    ["IO-", [10.64, 3.36, "HIO"]],
    ["CN-", [9.21, 4.79, "HCN"]],
    ["NH3", [9.25, 4.75, "NH4+"]],
    ["HO2-", [11.62, 2.38, "H2O2"]],
    ["C6H5O-", [9.95, 4.05, "C6H5OH"]],
    ["H2BO3-", [9.24, 4.76, "H3BO3"]],
    ["HSiO3-", [9.77, 4.23, "H2SiO3"]],
    ["SiO3^{2-}", [11.80, 2.20, "HSiO3-"]],
    ["HC2O4-", [1.25, 12.75, "H2C2O4"]],
    ["C2O4^{2-}", [4.27, 9.73, "HC2O4-"]],
    ["HSO3-", [1.81, 12.19, "H2SO3"]],
    ["SO3^{2-}", [6.91, 7.09, "HSO3-"]],
    ["H2AsO4-", [2.22, 11.78, "H3AsO4"]],
    ["HAsO4^{2-}", [6.98, 7.02, "H2AsO4-"]],
    ["AsO4^{3-}", [11.50, 2.50, "HAsO4^{2-}"]],
    ["HCrO4-", [0.74, 13.26, "H2CrO4"]],
    ["CrO4^{2-}", [6.49, 7.51, "HCrO4-"]],
    ["CH3NH2", [10.64, 3.36, "CH3NH3+"]],
    ["(CH3)2NH", [10.73, 3.27, "(CH3)2NH2+"]],
    ["(CH3)3N", [9.80, 4.20, "(CH3)3NH+"]],
    ["C2H5NH2", [10.81, 3.19, "C2H5NH3+"]],
    ["C6H5NH2", [4.63, 9.37, "C6H5NH3+"]],
    ["N2H4", [8.07, 5.93, "N2H5+"]],
    ["HONH2", [5.96, 8.04, "HONH3+"]],
    ["H2NCONH2", [0.18, 13.82, "H2NCONH3+"]],
    ["C5H5N", [5.23, 8.77, "C5H5NH+"]]
]$

/* Get all data for an ACID: returns [pKa, pKb, base] or false */
chem_acidbase_acid_data(acid) := assoc(acid, %_ACIDBASE_DATA)$

/* Get all data for a BASE: returns [pKa, pKb, acid] or false */
chem_acidbase_base_data(base) := assoc(base, %_ACIDBASE_DATA_REV)$

/* Get pKa for an ACID */
chem_acidbase_pKa(acid) := block([data],
    data: chem_acidbase_acid_data(acid),
    if is(data = false) then null else first(data)
)$

/* Get pKb for a BASE */
chem_acidbase_pKb(base) := block([data],
    data: chem_acidbase_base_data(base),
    if is(data = false) then null else second(data)
)$

/* Get Ka for an ACID */
chem_acidbase_Ka(acid) := block([pKa],
    pKa: chem_acidbase_pKa(acid),
    if is(pKa = null) then null
    else if not numberp(pKa) then null
    else 10^(-pKa)
)$

/* Get Kb for a BASE */
chem_acidbase_Kb(base) := block([pKb],
    pKb: chem_acidbase_pKb(base),
    if is(pKb = null) then null
    else if not numberp(pKb) then null
    else 10^(-pKb)
)$

/* Get conjugate base for an acid */
chem_acidbase_conjugate_base(acid) := block([data],
    data: chem_acidbase_acid_data(acid),
    if is(data = false) then "" else third(data)
)$

/* Get conjugate acid for a base */
chem_acidbase_conjugate_acid(base) := block([data],
    data: chem_acidbase_base_data(base),
    if is(data = false) then "" else third(data)
)$

/* Basic helper for formula display */
chem_display(substance) := sconcat("\\ce{", substance, "}")$

/* Navigation arrays */

/* All acids */
chem_acid_array() := map(first, %_ACIDBASE_DATA)$

/* All bases */
chem_base_array() := map(first, %_ACIDBASE_DATA_REV)$

/* Strong acids: pKa < 0 */
chem_strong_acid_array() := block([result, entry, pKa],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        pKa: first(second(entry)),
        if numberp(pKa) and is(pKa < 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Weak acids: pKa > 0 */
chem_weak_acid_array() := block([result, entry, pKa],
    result: [],
    for entry in %_ACIDBASE_DATA do (
        pKa: first(second(entry)),
        if numberp(pKa) and is(pKa > 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Strong bases: pKb <= 0 */
chem_strong_base_array() := block([result, entry, pKb],
    result: [],
    for entry in %_ACIDBASE_DATA_REV do (
        pKb: second(second(entry)),
        if numberp(pKb) and is(pKb <= 0) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Weak bases: 0 < pKb < 14 */
chem_weak_base_array() := block([result, entry, pKb],
    result: [],
    for entry in %_ACIDBASE_DATA_REV do (
        pKb: second(second(entry)),
        if numberp(pKb) and is(pKb > 0) and is(pKb < 14) then
            result: append(result, [first(entry)])
    ),
    result
)$

/* Legacy: return all acid formulas */
chem_acidbase_array() := chem_acid_array()$